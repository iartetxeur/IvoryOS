# Bombas Ismatec
PUMP_1_COM=COM10
PUMP_2_COM=COM12

# Agitador IKA RCT 5
IKA_COM=COM11

# Chopper Thorlabs
CHOPPER_COM=COM6

# Laser OBIS
LASER_COM=COM7

# Luz G2V Pico (dejar vacio si no se usa)
